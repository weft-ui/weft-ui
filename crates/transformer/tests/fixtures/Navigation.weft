event Action()

app Notes {
    tabs {
        Home(title = "Home", icon = "asset:tab_home")
        Settings(title = "Settings", icon = "asset:tab_settings")
    }
}

page Home() {
    NavBar(title = "Home")
    Text("Home")
}

page Settings() {
    NavBar(title = "Settings")
    Text("Settings")
}

page Detail(id: String) {
    NavBar(title = "Note ${id}") {
        BarButton(label = "Action", onTap = Action())
    }
    Text(id)
}
