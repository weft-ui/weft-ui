<template name="Lists"><view class="w-column{{wParent}}"><scroll-view class="w-list w-scroll-v w-grow w-fill" scroll-y enable-flex enhanced show-scrollbar="{{true}}" id="wl-{{ws}}-0" data-scope="{{ws}}" data-point="0" bindscroll="$scroll" scroll-top="{{z2}}"><view class="w-scroll-content-v" style="box-sizing:border-box;gap:8px{{wFocus ? ';padding-bottom:16px' : ''}}"><text class="w-text w-in-scroll">Header</text><block wx:for="{{l2}}" wx:for-item="segment" wx:key="k"><view class="w-lazy-segment wl-segment-{{ws}}-0" data-segment="{{segment.k}}" style="display:flex;flex-direction:column;align-self:stretch;gap:8px;{{segment.r ? '' : segment.s}}"><block wx:for="{{segment.r}}" wx:for-item="lazyrow" wx:key="k"><block wx:if="{{lazyrow.w}}"><view class="w-lazy-row"><template is="Lists-l2" data="{{...lazyrow}}"/></view></block><view wx:else class="w-lazy-row" style="height:44px"></view></block></view></block><text class="w-text w-in-scroll">Footer</text></view></scroll-view><scroll-view class="w-grid w-scroll-v w-grow w-fill" scroll-y enable-flex enhanced data-columns="{{3}}" show-scrollbar="{{true}}" id="wl-{{ws}}-1" data-scope="{{ws}}" data-point="1" bindscroll="$scroll" scroll-top="{{z6}}"><view class="w-scroll-content-v" style="box-sizing:border-box;gap:4px{{wFocus ? ';padding-bottom:16px' : ''}}"><block wx:for="{{l6}}" wx:for-item="segment" wx:key="k"><view class="w-lazy-segment wl-segment-{{ws}}-1" data-segment="{{segment.k}}" style="display:grid;align-self:stretch;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;{{segment.r ? '' : segment.s}}"><block wx:for="{{segment.r}}" wx:for-item="lazyrow" wx:key="k"><block wx:if="{{lazyrow.w}}"><view class="w-lazy-row"><template is="Lists-l6" data="{{...lazyrow}}"/></view></block><view wx:else class="w-lazy-row" style="height:44px"></view></block></view></block></view></scroll-view></view></template>
<template name="Lists-l2"><text class="w-text">{{n1_0}}</text></template>
<template name="Lists-l6"><text class="w-text">{{n5_0}}</text></template>
<view wx:if="{{t}}" class="w-root" style="padding-bottom:{{kh}}px"><template is="{{t}}" data="{{...r, wParent: '', wFocus: kf}}"/></view>
