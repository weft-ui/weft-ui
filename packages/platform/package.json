{
  "name": "@weft-ui/platform",
  "version": "0.2.0",
  "description": "Cross-platform APIs for Weft UI apps on Web, WeChat, and native",
  "license": "Apache-2.0",
  "homepage": "https://github.com/weft-ui/weft-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weft-ui/weft-ui.git",
    "directory": "packages/platform"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "weft-web": "./src/web.ts",
      "weft-wechat": "./src/wechat.ts",
      "weft-native": "./src/native.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "weft-web": "./dist/web.js",
        "weft-wechat": "./dist/wechat.js",
        "weft-native": "./dist/native.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/index.d.ts dist/",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@weft-ui/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0"
  }
}
