{
  "name": "@weft-ui/compiler",
  "version": "0.2.0",
  "description": "Weft UI compiler, built from Rust to WebAssembly",
  "license": "Apache-2.0",
  "homepage": "https://github.com/weft-ui/weft-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weft-ui/weft-ui.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "dist",
    "wasm"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:wasm": "cargo build -p weft-ui-wasm --release --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir wasm --out-name weft_ui_wasm ../../target/wasm32-unknown-unknown/release/weft_ui_wasm.wasm",
    "prepublishOnly": "pnpm build:wasm && pnpm build"
  },
  "dependencies": {
    "@weft-ui/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "7.1.0-beta"
  }
}
