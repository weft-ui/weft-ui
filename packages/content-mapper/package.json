{
  "name": "@weft-ui/content-mapper",
  "version": "0.2.0",
  "description": "TypeScript content mapper for .weft files",
  "license": "Apache-2.0",
  "homepage": "https://github.com/weft-ui/weft-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weft-ui/weft-ui.git",
    "directory": "packages/content-mapper"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/server.js"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@weft-ui/compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "7.1.0-beta"
  }
}
