{
  "name": "@weft-ui/native-windows",
  "version": "0.2.0",
  "description": "Weft UI native shell and prebuilt kernel for Windows",
  "license": "Apache-2.0",
  "homepage": "https://github.com/weft-ui/weft-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weft-ui/weft-ui.git",
    "directory": "native/windows"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../pack.mjs prepack windows",
    "postpack": "node ../pack.mjs postpack windows",
    "prepublishOnly": "node ../pack.mjs prepublishOnly windows"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE-hermes",
    "Weft.WinUI.targets",
    "Weft.WinUI",
    "!Weft.WinUI/**/bin/**",
    "!Weft.WinUI/**/obj/**",
    "build/win-x64/weft_core.dll",
    "build/win-arm64/weft_core.dll"
  ],
  "dependencies": {
    "hermes-compiler": "260318099.0.8"
  },
  "weft": {
    "protocol": 3
  }
}
