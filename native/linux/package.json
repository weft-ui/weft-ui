{
  "name": "@weft-ui/native-linux",
  "version": "0.2.0",
  "description": "Weft UI native shell and prebuilt kernel for Linux",
  "license": "Apache-2.0",
  "homepage": "https://github.com/weft-ui/weft-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weft-ui/weft-ui.git",
    "directory": "native/linux"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../pack.mjs prepack linux",
    "postpack": "node ../pack.mjs postpack linux",
    "prepublishOnly": "node ../pack.mjs prepublishOnly linux"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE-hermes",
    "CMakeLists.txt",
    "core",
    "include",
    "src",
    "build/linux-x64/libweft_core.so",
    "build/linux-arm64/libweft_core.so",
    "build/linux-arm64/bin/hermesc"
  ],
  "dependencies": {
    "hermes-compiler": "260318099.0.8"
  },
  "weft": {
    "protocol": 3
  }
}
