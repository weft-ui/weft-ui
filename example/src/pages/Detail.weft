import "../Fieldnotes.weft"

style DetailCopy { color = "#243c32", size = 16, lineHeight = 24 }

component TrailComment(name: String, date: String, message: String, avatar: String) {
    Row(fill = true, gap = 10, paddingY = 12) {
        Image(avatar, width = 32, height = 32, radius = 16)
        Column(grow = 1, gap = 4) {
            Row(fill = true, gap = 8, align = "center", justify = "spaceBetween") {
                Text(name, style = FieldLabel, size = 14)
                Text(date, style = FieldMuted, size = 12)
            }
            Text(message, fill = true, size = 14, lineHeight = 20, color = "#243c32")
        }
    }
}

component Detail() {
    Screen {
        header: {
            Row(fill = true, paddingX = 20, paddingY = 14, align = "center", justify = "spaceBetween") {
                Text("FIELDNOTES", style = FieldKicker)
                Text("TRAIL LOG  /  01", style = FieldKicker)
            }
        }
        Scroll(indicators = false) {
            Column(fill = true, gap = 18, paddingBottom = 20) {
                Stack(fill = true, height = 220, alignment = "bottom", clip = true) {
                    Image("asset:field_ridge", fill = true, fit = "cover", placeholder = "#4c7260")
                    Column(fill = true, paddingX = 20, paddingBottom = 16, justify = "end", gap = 5) {
                        Spacer()
                        Column(fill = true, padding = 12, gap = 5, radius = 10, background = "#102b24d9") {
                            Text("MOUNTAINS  /  6 MIN READ", size = 11, weight = "bold", color = "#d9e7c9")
                            Text("The long way up Juniper Ridge", fill = true, maxLines = 2,
                                size = 27, weight = "bold", color = "#ffffff")
                        }
                    }
                }
                Column(fill = true, paddingX = 20, gap = 14) {
                    Row(fill = true, gap = 9, align = "center") {
                        Image("asset:field_mara", width = 36, height = 36, radius = 18)
                        Column(gap = 2) {
                            Text("Mara Chen", style = FieldLabel, size = 14)
                            Text("October 12  ·  7.2 km loop", style = FieldMuted, size = 12)
                        }
                    }
                    Text(fill = true, style = DetailCopy) {
                        Span("We left the trailhead at first light. At the fork, take the ")
                        Span("old fire road", weight = "bold")
                        Span(" past the dry creek. It climbs more gently than the signed route.")
                    }
                    Text(fill = true, style = DetailCopy) {
                        Span("The last stretch crosses exposed rock. Stop at the ")
                        Span("second cairn", weight = "bold")
                        Span(" for the clearest view of the valley before the trail bends back into the trees.")
                    }
                    Column(fill = true, gap = 8) {
                        Text("Trail comments (2)", style = FieldLabel, size = 18)
                        Column(fill = true, paddingX = 12, style = FieldCard) {
                            TrailComment("Ivo Reyes", "Oct 13", "The fire road is still firm after the rain.", "asset:avatar")
                            Divider(color = "#deded2")
                            TrailComment("Mara Chen", "Oct 14", "Good to know. The creek bed was dry on Saturday.", "asset:field_mara")
                        }
                    }
                }
            }
        }
    }
}
