import "../Fieldnotes.weft"

type TrailCategory = "All notes" | "Mountains" | "Coast" | "After dark"
type FeedTab = "Explore" | "Saved"

component CategoryTag(label: TrailCategory, active: Bool, onSelect: Event<TrailCategory>) {
    Row(height = 44, paddingX = 14, radius = 22, align = "center", justify = "center",
        background = if (active) "#245347" else "#ecece2", onTap = onSelect(label)) {
        Text(label, size = 14, weight = "semibold", color = if (active) "#ffffff" else "#28463c")
    }
}

component FeedCard(cover: String, title: String, category: String, author: String, avatar: String, likes: Int) {
    let count = "${likes} likes"
    Column(fill = true, clip = true, style = FieldCard) {
        Image(cover, fill = true, aspectRatio = 1.6, fit = "cover", placeholder = "#d6e2d3")
        Column(fill = true, padding = 14, gap = 6) {
            Text(category, style = FieldKicker)
            Text(title, fill = true, maxLines = 2, lineHeight = 24, style = FieldLabel, size = 20)
            Row(fill = true, gap = 8, align = "center", paddingTop = 3) {
                Image(avatar, width = 24, height = 24, radius = 12)
                Text(author, style = FieldMuted, size = 13)
                Spacer()
                Text(count, style = FieldMuted, size = 13)
            }
        }
    }
}

component FeedTabItem(label: FeedTab, active: Bool, onSelect: Event<FeedTab>) {
    Column(width = 116, height = 50, gap = 4, align = "center", justify = "center", onTap = onSelect(label)) {
        Row(width = 20, height = 3, radius = 1, background = if (active) "#376253" else "#ffffff")
        Text(label, size = 14, weight = "semibold", color = if (active) "#245347" else "#5b695f")
    }
}

component Feed() {
    state category: TrailCategory = "All notes"
    state tab: FeedTab = "Explore"
    let saved = tab == "Saved"
    Screen {
        header: {
            Column(fill = true, gap = 10, paddingY = 14) {
                Row(fill = true, paddingX = 20, gap = 12, align = "center", justify = "spaceBetween") {
                    Column(gap = 3) {
                        Text("THE OUTDOOR JOURNAL", style = FieldKicker)
                        Text("Fieldnotes", style = FieldTitle)
                    }
                    Stack(width = 44, height = 44, alignment = "center", background = "#ffffff", radius = 12,
                        border = 1, onTap = { tab = "Explore"; category = "All notes" }) {
                        Image("asset:compass", width = 22, height = 22, fit = "contain")
                    }
                }
                if (!saved) {
                    Scroll(direction = "horizontal", height = 44, fill = true, grow = 0, gap = 8, indicators = false) {
                        Spacer(size = 12)
                        CategoryTag("All notes", category == "All notes", onSelect = { value -> category = value })
                        CategoryTag("Mountains", category == "Mountains", onSelect = { value -> category = value })
                        CategoryTag("Coast", category == "Coast", onSelect = { value -> category = value })
                        CategoryTag("After dark", category == "After dark", onSelect = { value -> category = value })
                        Spacer(size = 12)
                    }
                }
            }
        }
        Scroll(indicators = false) {
            Column(fill = true, gap = 14, paddingX = 20, paddingBottom = 20) {
                Text(if (saved) "BOOKMARKED NOTES" else "LATEST NOTES", style = FieldKicker)
                if (!saved && (category == "All notes" || category == "Mountains")) {
                    FeedCard("asset:field_ridge", "The long way up Juniper Ridge", "MOUNTAINS  /  6 MIN READ",
                        "Mara Chen", "asset:field_mara", 128)
                }
                if (saved || category == "All notes" || category == "Coast") {
                    FeedCard("asset:field_coast", "A tidepool walk at Salt Point", "COAST  /  4 MIN READ",
                        "Ivo Reyes", "asset:avatar", 74)
                }
                if (!saved && (category == "All notes" || category == "After dark")) {
                    FeedCard("asset:hero", "A clear night above the tree line", "AFTER DARK  /  5 MIN READ",
                        "Mara Chen", "asset:field_mara", 96)
                }
            }
        }
        footer: {
            Stack(fill = true, height = 56, alignment = "bottom", background = "#ffffff", shadow = "medium") {
                Row(width = 280, height = 56, align = "center", justify = "spaceEvenly") {
                    FeedTabItem("Explore", !saved, onSelect = { value -> tab = value })
                    FeedTabItem("Saved", saved, onSelect = { value -> tab = value })
                }
            }
        }
    }
}
