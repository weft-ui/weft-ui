component ListExample(listRows: String[]) {
    List(gap = 8, padding = 20, indicators = false) {
        Column(fill = true, gap = 6, paddingBottom = 12) {
            Text("Lazy list", size = 28, weight = "bold")
            Text("1,000 variable-height rows", size = 14, color = "#5b695f")
        }
        for (row in listRows; key = row) {
            Column(fill = true, height = if (row.length > 20) 100 else 60, padding = 16,
                justify = "center", background = "#ecece2", radius = 12) {
                Text(row, size = 16, color = "#28463c")
            }
        }
    }
}
