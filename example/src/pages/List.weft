event ListRefresh
event ListEndReached

component ListExample(listRows: String[], listRefreshing: Bool) {
    List(gap = 8, padding = 20, indicators = false, refreshing = listRefreshing, onRefresh = ListRefresh, onEndReached = ListEndReached) {
        Column(fill = true, gap = 6, paddingBottom = 12) {
            Text("Lazy list", size = 28, weight = "bold")
            Text("Pull down to refresh; scroll to the end to load more.", size = 14, color = "#5b695f")
        }
        for (row in listRows; key = row) {
            Column(fill = true, height = if (row.length > 20) 100 else 60, padding = 16,
                justify = "center", background = "#ecece2", radius = 12) {
                Text(row, size = 16, color = "#28463c")
            }
        }
    }
}
