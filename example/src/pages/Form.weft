import "../Fieldnotes.weft"

component RegistrationField(label: String, field: Children) {
    Column(fill = true, gap = 3) {
        Text(label, style = FieldLabel, size = 13)
        field
    }
}

component Form(fieldRegions: String[]) {
    state name = ""
    state email = ""
    state password = ""
    state phone = ""
    state years = ""
    state region = -1
    state bio = ""
    state agreed = false
    state submitted = false
    let missing = name == "" || email == "" || password == "" || !agreed
    Screen {
        header: {
            Column(fill = true, paddingX = 20, paddingY = 16) {
                PageHeading("FIELDNOTES  /  MEMBERSHIP", "Create your account", "Keep a journal of the places you walk.")
            }
        }
        Scroll(indicators = false) {
            Column(fill = true, paddingX = 20, paddingBottom = 20) {
                Column(fill = true, padding = 14, gap = 9, style = FieldCard) {
                    RegistrationField("Full name") {
                        Input(name, type = "text", fill = true, height = 28, placeholder = "Mara Chen",
                            onChange = { value -> name = value })
                    }
                    RegistrationField("Email address") {
                        Input(email, type = "email", fill = true, height = 28, placeholder = "name@example.com",
                            onChange = { value -> email = value })
                    }
                    RegistrationField("Password") {
                        Input(password, type = "password", fill = true, height = 28, placeholder = "Choose a password",
                            onChange = { value -> password = value })
                    }
                    RegistrationField("Phone (optional)") {
                        Input(phone, type = "phone", fill = true, height = 28, placeholder = "Phone number",
                            onChange = { value -> phone = value })
                    }
                    RegistrationField("Years hiking (optional)") {
                        Input(years, type = "number", fill = true, height = 28, placeholder = "0",
                            onChange = { value -> years = value })
                    }
                    RegistrationField("Home region") {
                        Picker(region, options = fieldRegions, placeholder = "Choose a region", fill = true,
                            onChange = { value -> region = value })
                    }
                    RegistrationField("About you (optional)") {
                        TextArea(bio, fill = true, height = 52, placeholder = "Where do you like to walk?",
                            onChange = { value -> bio = value })
                    }
                    Row(fill = true, minHeight = 32, gap = 8, align = "center") {
                        Checkbox(agreed, onChange = { value -> agreed = value })
                        Text("I agree to the membership terms.", style = FieldMuted, size = 13)
                    }
                    if (submitted) {
                        Text("Registration preview complete. No data was sent.", style = FieldLabel, size = 14)
                    }
                    Button(fill = true, minHeight = 44, disabled = missing, onClick = { submitted = true }) {
                        Text("Create account", size = 15, weight = "semibold")
                    }
                }
            }
        }
    }
}
