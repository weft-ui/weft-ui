import "../Fieldnotes.weft"
import "./Theme.weft"

style FieldSettingsGroup { fill = true, radius = 16, border = 1, background = theme.card, borderColor = theme.border }
style FieldSettingsSection { color = theme.text, size = 18, weight = "semibold" }
style FieldSettingsLabel { color = theme.text, size = 15, weight = "semibold" }
style FieldSettingsNote { color = theme.accent, size = 14 }

component SettingsValue(label: String, detail: String) {
    Row(fill = true, minHeight = 46, paddingX = 14, gap = 10, align = "center", justify = "spaceBetween") {
        Text(label, style = FieldSettingsLabel)
        Text(detail, style = FieldSettingsNote)
    }
}

component Settings() {
    state distance = "Kilometers"
    state dateFormat = "Oct 12"
    Screen(surface = theme.surface) {
        header: {
            Column(fill = true, padding = 20, gap = 5) {
                Text("FIELDNOTES  /  PREFERENCES", style = FieldSettingsNote, size = 12, weight = "bold")
                Text("Settings", color = theme.text, size = 31, weight = "bold")
                Text("Choose how your journal displays dates and routes.", style = FieldSettingsNote)
            }
        }
        Scroll(indicators = false) {
            Column(fill = true, paddingX = 20, paddingBottom = 20, gap = 20) {
                Column(fill = true, gap = 8) {
                    Text("Display", style = FieldSettingsSection)
                    Column(style = FieldSettingsGroup) {
                        SettingsValue("Appearance", "Follow system")
                        Divider(color = theme.border)
                        ChoiceRow("Date format", dateFormat, if (dateFormat == "Oct 12") "12 Oct" else "Oct 12",
                            ink = theme.text, accent = theme.accent, onSelect = { value -> dateFormat = value })
                    }
                }
                Column(fill = true, gap = 8) {
                    Text("Trail journal", style = FieldSettingsSection)
                    Column(style = FieldSettingsGroup) {
                        ChoiceRow("Distance units", distance, if (distance == "Kilometers") "Miles" else "Kilometers",
                            ink = theme.text, accent = theme.accent, onSelect = { value -> distance = value })
                        Divider(color = theme.border)
                        SettingsValue("Route sorting", "Newest first")
                    }
                }
                Text("Appearance follows your device’s light or dark setting.", style = FieldSettingsNote, size = 13)
            }
        }
    }
}
