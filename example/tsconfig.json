{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "vite.config.ts"],
  "contentMappers": [{ "package": "@weft-ui/content-mapper", "extensions": [".weft"] }]
}
