{
  "name": "weft",
  "displayName": "Weft",
  "scopeName": "source.weft",
  "fileTypes": ["weft"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "match": "\\b(model|event|component|style)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.weft" },
            "2": { "name": "entity.name.type.weft" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?==)",
          "captures": {
            "1": { "name": "storage.type.weft" },
            "2": { "name": "entity.name.type.weft" }
          }
        },
        {
          "match": "\\b(theme)\\s*(?=\\{)",
          "captures": {
            "1": { "name": "storage.type.weft" }
          }
        },
        {
          "match": "\\b(state|let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.weft" },
            "2": { "name": "variable.other.weft" }
          }
        },
        { "match": "@[A-Za-z_][A-Za-z0-9_]*", "name": "constant.other.color.weft" },
        { "match": "\\bimport\\b", "name": "keyword.control.import.weft" },
        { "match": "\\b(if|else|for|in|key)\\b", "name": "keyword.control.weft" },
        { "match": "\\b(true|false|null)\\b", "name": "constant.language.weft" },
        {
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b",
          "name": "constant.numeric.weft"
        },
        { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "name": "entity.name.type.weft" },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=:(?!:))",
          "captures": { "1": { "name": "entity.name.tag.slot.weft" } }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?==(?!=))",
          "captures": { "1": { "name": "variable.parameter.weft" } }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.weft" } }
        },
        {
          "match": "->|\\?\\.|\\?\\?|&&|\\|\\||[=!<>]=?|[+\\-*/%]=?|\\?|!",
          "name": "keyword.operator.weft"
        }
      ]
    },
    "comments": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.weft" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.weft" }
      ]
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.weft",
      "patterns": [
        {
          "match": "\\\\([nrt0\\\\\"$]|u\\{[0-9A-Fa-f]+\\})",
          "name": "constant.character.escape.weft"
        },
        {
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.weft" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.weft" } },
          "name": "meta.interpolation.weft",
          "contentName": "source.weft",
          "patterns": [{ "include": "#code" }]
        }
      ]
    }
  }
}
