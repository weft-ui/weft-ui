event Open()
event Replace()
event Root()
event Present()
event PresentFullScreen()
event PushInModal()
event Dismiss()

page Home() {
    NavBar(title = "Home")
    Button(onClick = { Open() }) { Text("Open") }
    Button(onClick = { Present() }) { Text("Present") }
    Button(onClick = { PresentFullScreen() }) { Text("Present full screen") }
}

page Detail(id: String, from: String = "feed") path "/notes/{id}" {
    NavBar(title = "Note ${id}") {
        BarButton(label = "Replace", onTap = { Replace() })
    }
    Column {
        Text("Detail ${id}")
        Button(onClick = { Replace() }) { Text("Replace") }
        Button(onClick = { Root() }) { Text("Root") }
    }
}

page Settings() {
    NavBar(title = "Settings")
    Text("Settings")
}

page Modal() {
    NavBar(title = "Modal")
    Column {
        Text("Modal")
        Button(onClick = { PushInModal() }) { Text("Push") }
        Button(onClick = { Dismiss() }) { Text("Dismiss") }
    }
}

app Notes {
    tabs {
        Home(title = "Home", icon = "asset:tab_home")
        Settings(title = "Settings", icon = "asset:tab_settings")
    }
}
