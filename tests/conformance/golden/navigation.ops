# mount
create 1 0  # Home
nav 0 [1] [] 0

# push detail
create 2 1  # Detail
set 2 0 "Note 1"  # NavBar.title
set 2 1 "Detail 1"  # Text.value
nav 0 [1] [2] 0

# back
(no ops)

# push again
create 3 1  # Detail
set 3 0 "Note 1"  # NavBar.title
set 3 1 "Detail 1"  # Text.value
nav 0 [1] [3] 0

# replace detail
create 4 1  # Detail
set 4 0 "Note 2"  # NavBar.title
set 4 1 "Detail 2"  # Text.value
nav 0 [1] [4] 0

# pop to root
nav 0 [1] [] 0
