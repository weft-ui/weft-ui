# mount
create 1 0  # Home
nav 0 [1 0] [] 0

# push detail
create 2 1  # Detail
set 2 0 "Note 1"  # NavBar.title
set 2 1 "Detail 1"  # Text.value
nav 0 [1 0] [2] 0

# back
(no ops)

# push again
create 3 1  # Detail
set 3 0 "Note 1"  # NavBar.title
set 3 1 "Detail 1"  # Text.value
nav 0 [1 0] [3] 0

# replace detail
create 4 1  # Detail
set 4 0 "Note 2"  # NavBar.title
set 4 1 "Detail 2"  # Text.value
nav 0 [1 0] [4] 0

# pop to root
nav 0 [1 0] [] 0

# badge
(no ops)

# select settings
create 5 2  # Settings
nav 1 [1 5] [] 0

# select home
(no ops)

# push before tab
create 6 1  # Detail
set 6 0 "Note 1"  # NavBar.title
set 6 1 "Detail 1"  # Text.value
nav 0 [1 5] [6] 0

# switch clears stack
nav 1 [1 5] [] 0

# clear badge
(no ops)

# home for modal
(no ops)

# present sheet
create 7 3  # Modal
nav 0 [1 5] [] 7 sheet

# push while modal
(no ops)

# dismiss from app
nav 0 [1 5] [] 0

# present full screen
create 8 3  # Modal
nav 0 [1 5] [] 8 fullScreen

# dismiss from host
(no ops)

# dismiss with no modal
(no ops)

# open settings link
nav 1 [1 5] [] 0

# open detail link
create 9 1  # Detail
set 9 0 "Note 3"  # NavBar.title
set 9 1 "Detail 3"  # Text.value
nav 1 [1 5] [9] 0
